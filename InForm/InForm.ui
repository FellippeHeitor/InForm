'---------------------------------------------------------------------------------
FUNCTION uspacing&
    DIM __uspacing AS LONG: __uspacing = _UFONTHEIGHT
    SELECT CASE _FONT
        CASE 16
            __uspacing = __uspacing + __UI_Font16Offset
        CASE 8
            __uspacing = __uspacing + __UI_Font8Offset
    END SELECT
    uspacing = __uspacing
END FUNCTION

'---------------------------------------------------------------------------------
SUB __UI_InternalMenus
    'Internal "design mode" context menu. -------------------------------------------
